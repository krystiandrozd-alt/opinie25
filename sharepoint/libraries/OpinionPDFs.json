{
  "LibraryName": "OpinionPDFs",
  "Title": "Student Opinion PDFs",
  "Description": "Document library for generated student opinion package PDFs",
  "EnableVersioning": true,
  "MajorVersionLimit": 5,
  "ContentTypesEnabled": false,
  "RequireCheckOut": false,
  "Columns": [
    {
      "Name": "StudentName",
      "Type": "Text",
      "Required": true,
      "DisplayName": "Student Name"
    },
    {
      "Name": "SectionName",
      "Type": "Text",
      "Required": true,
      "DisplayName": "Section"
    },
    {
      "Name": "SchoolYear",
      "Type": "Text",
      "Required": true,
      "DisplayName": "School Year"
    },
    {
      "Name": "Semester",
      "Type": "Choice",
      "Required": true,
      "DisplayName": "Semester",
      "Choices": ["Semester 1", "Semester 2", "Year-End"]
    },
    {
      "Name": "OpinionCycleID",
      "Type": "Text",
      "Required": false,
      "DisplayName": "Opinion Cycle ID",
      "Description": "GUID of the opinion cycle in Dataverse"
    },
    {
      "Name": "PackageID",
      "Type": "Text",
      "Required": false,
      "DisplayName": "Package ID",
      "Description": "GUID of the student opinion package in Dataverse"
    },
    {
      "Name": "GeneratedDate",
      "Type": "DateTime",
      "Required": false,
      "DisplayName": "Generated Date"
    },
    {
      "Name": "SentToParents",
      "Type": "Boolean",
      "Required": false,
      "DisplayName": "Sent to Parents",
      "Default": false
    },
    {
      "Name": "SentDate",
      "Type": "DateTime",
      "Required": false,
      "DisplayName": "Sent Date"
    },
    {
      "Name": "ParentEmail",
      "Type": "Text",
      "Required": false,
      "DisplayName": "Parent Email"
    },
    {
      "Name": "TotalPages",
      "Type": "Number",
      "Required": false,
      "DisplayName": "Total Pages"
    },
    {
      "Name": "OpinionCount",
      "Type": "Number",
      "Required": false,
      "DisplayName": "Opinion Count",
      "Description": "Number of subject opinions included"
    }
  ],
  "Views": [
    {
      "Name": "All PDFs",
      "ViewType": "Standard",
      "Default": true,
      "Columns": ["Name", "StudentName", "SectionName", "SchoolYear", "Semester", "GeneratedDate", "SentToParents"],
      "Sort": [{"Column": "GeneratedDate", "Ascending": false}]
    },
    {
      "Name": "By Section",
      "ViewType": "Standard",
      "Columns": ["StudentName", "SectionName", "GeneratedDate", "SentToParents"],
      "GroupBy": "SectionName",
      "Sort": [{"Column": "StudentName", "Ascending": true}]
    },
    {
      "Name": "Not Sent",
      "ViewType": "Standard",
      "Filter": "SentToParents eq false",
      "Columns": ["StudentName", "SectionName", "GeneratedDate", "ParentEmail"]
    },
    {
      "Name": "Sent to Parents",
      "ViewType": "Standard",
      "Filter": "SentToParents eq true",
      "Columns": ["StudentName", "SectionName", "SentDate", "ParentEmail"],
      "Sort": [{"Column": "SentDate", "Ascending": false}]
    },
    {
      "Name": "Current Semester",
      "ViewType": "Standard",
      "Filter": "SchoolYear eq '2024/2025'",
      "Columns": ["StudentName", "SectionName", "Semester", "GeneratedDate", "SentToParents"]
    }
  ],
  "Permissions": {
    "BreakInheritance": true,
    "Groups": [
      {
        "Name": "School Administrators",
        "Permission": "Full Control"
      },
      {
        "Name": "Homeroom Teachers",
        "Permission": "Contribute"
      },
      {
        "Name": "System Flows",
        "Permission": "Contribute"
      }
    ]
  },
  "FolderStructure": [
    {
      "Path": "/2024-2025/Semester1",
      "Description": "PDFs for 2024/2025 Semester 1"
    },
    {
      "Path": "/2024-2025/Semester2",
      "Description": "PDFs for 2024/2025 Semester 2"
    },
    {
      "Path": "/Archive",
      "Description": "Archived PDFs from previous years"
    }
  ],
  "Notes": [
    "PDFs are automatically generated by Power Automate flows",
    "File naming convention: {StudentName}_{SectionName}_{Semester}_{Date}.pdf",
    "Only homeroom teachers and administrators can access PDFs",
    "PDFs are automatically organized into folders by school year and semester"
  ]
}
